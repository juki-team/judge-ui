# judge-ui — variables for the Dokploy deploy (Application > Environment).
# Copy each block into its Dokploy section. Never put real values in this file.
#
# Dokploy has three kinds of variables and they are NOT interchangeable:
#   1. Environment Settings  -> runtime only (`node server.js`), never seen by `pnpm build`.
#   2. Build-time Arguments  -> `docker build --build-arg`, only for the ARGs declared in the Dockerfile.
#   3. Build-time Secrets    -> `RUN --mount=type=secret`, not stored in the image layers.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle by `pnpm build`, so they MUST go in
# Build-time Arguments: in Environment Settings they would be empty in the browser.
# Changing one of them requires a rebuild (redeploy), not just a restart.

# ===================================================================================================
# 1. Environment Settings (runtime, server side only)
# ===================================================================================================

# Shared secret sent by the server-rendered print pages (/print/...) to the API (header
# HEADER_JUKI_INTERNAL_API_KEY). Must be the same value as JUKI_INTERNAL_API_KEY in juki-service.
# Server only: never prefix it with NEXT_PUBLIC_.
JUKI_INTERNAL_API_KEY=

# ===================================================================================================
# 2. Build-time Arguments (declared as ARG in the Dockerfile)
# ===================================================================================================

NODE_ENV=production

# Base URL of the juki-service API v2 (no trailing slash), e.g. https://api.example.com/api/v2
NEXT_PUBLIC_JUKI_SERVICE_V2_URL=

# Name of the session token (cookie / header) shared with the API
NEXT_PUBLIC_JUKI_TOKEN_NAME=

# ===================================================================================================
# 3. Build-time Secrets
# ===================================================================================================

# None: the build does not need any secret.

# ---------------------------------------------------------------------------------------------------
# Fixed in the Dockerfile, do not set them in Dokploy: NEXT_OUTPUT=standalone, PORT=3000, HOSTNAME=0.0.0.0
# Optional, read by base-ui but not declared as ARG in the Dockerfile (so Dokploy can't pass it yet):
#   NEXT_PUBLIC_ABLY_LOG_LEVEL (Ably client log level, default 0 = off)
