# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno (judge-ui)
#
# Cópiala a `.env.local` y rellena los valores:
#     cp .env.sample .env.local
#
# NOTA: NODE_ENV lo gestiona Next.js automáticamente
#       (dev → development, build/start → production). No lo definas aquí.
# ─────────────────────────────────────────────────────────────

# ── Públicas (prefijo NEXT_PUBLIC_) ──────────────────────────

# URL base del API de Juki que consume la UI.
NEXT_PUBLIC_JUKI_SERVICE_V2_URL=https://api.local.juki.app/v3

# Nombre de la cookie/token de sesión de Juki.
NEXT_PUBLIC_JUKI_TOKEN_NAME=juki-token

# Nivel de log de Ably en el cliente. ej: NONE | ERROR | WARN | INFO | DEBUG
NEXT_PUBLIC_ABLY_LOG_LEVEL=INFO

# ── Privadas (solo servidor) ─────────────────────────────────
# Disponibles en runtime del lado servidor. Nunca se exponen al
# cliente. Mantenlas vacías en la plantilla.

# API key interna para llamadas servidor→servidor a Juki.
JUKI_INTERNAL_API_KEY=

# API key del AI Gateway (la usa el AI SDK). ej: vck_...
AI_GATEWAY_API_KEY=
