{
  "name": "judge-ui",
  "private": true,
  "version": "1.24.32",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "caddy": "caddy run --config Caddyfile",
    "dev": "next dev -p 3070",
    "build": "next build",
    "build:analyze": "ANALYZE=true pnpm build",
    "start": "next start",
    "lint": "eslint .",
    "pull": "pnpm add --save-exact @juki-team/commons@release-0.1 @juki-team/base-ui@release-0.1",
    "push": "f() { param=${1}; message=${param:-chore}; echo ${message}; git add .; echo $message | git commit -F -; pnpm version patch --no-git-tag-version --no-git-checks; version=\"v$(node -p \"require('./package.json').version\")\"; git add .; echo $version | git commit -F -; git push origin main; echo $version | git tag -a $(echo $version) -F -; git push origin --tags; }; f"
  },
  "dependencies": {
    "@ably/spaces": "^0.5.2",
    "@ai-sdk/react": "^4.0.163",
    "@excalidraw/excalidraw": "^0.18.1",
    "@juki-team/base-ui": "1.5.16",
    "@juki-team/commons": "0.1.47",
    "@reactour/tour": "^3.8.0",
    "@vercel/analytics": "^2.0.1",
    "ably": "^2.30.0",
    "ai": "^7.0.159",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resize-detector": "^12.3.0",
    "swr": "^2.5.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/virtual-core": "^3.19.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "i18next": "^26.6.0",
    "recharts": "^3.10.1",
    "sass": "^1.107.1",
    "typescript": "^6.0.3"
  }
}
