{
  "name": "judge-ui",
  "private": true,
  "version": "1.24.32",
  "scripts": {
    "caddy": "caddy run --config Caddyfile",
    "dev:ssl": "NODE_EXTRA_CA_CERTS=\"$HOME/Library/Application Support/Caddy/pki/authorities/local/root.crt\" next dev -p 3070",
    "dev": "next dev -p 3070",
    "build": "next build",
    "build:analyze": "ANALYZE=true yarn build",
    "start": "next start",
    "lint": "eslint .",
    "env:load": "unset NPM_GITHUB_TOKEN && export $(grep NPM_GITHUB_TOKEN .env | xargs)",
    "pull": "rm -rf node_modules pnpm-lock.yaml; pnpm add @juki-team/commons@latest @juki-team/base-ui@latest",
    "push": "f() { param=${1}; message=${param:-chore}; echo ${message}; git add .; echo $message | git commit -F -; yarn version --patch --no-git-tag-version; version=\"v$(node -p \"require('./package.json').version\")\"; git add .; echo $version | git commit -F -; git push origin main; echo $version | git tag -a $(echo $version) -F -; git push origin --tags; }; f",
    "doctor": "react-doctor"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ably/spaces": "^0.5.2",
    "@ai-sdk/react": "^3.0.193",
    "@excalidraw/excalidraw": "^0.18.1",
    "@juki-team/base-ui": "^1.4.135",
    "@juki-team/commons": "^0.2.17",
    "@reactour/tour": "^3.8.0",
    "@vercel/analytics": "^2.0.1",
    "ably": "^2.21.0",
    "ai": "^6.0.191",
    "i18next": "^26.2.0",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resize-detector": "^12.3.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "swr": "^2.4.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.6",
    "next-compose-plugins": "^2.2.1",
    "prettier": "^3.8.3",
    "react-doctor": "^0.2.6",
    "sass": "^1.100.0",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "@types/minimatch": "^5.0.0"
  }
}
